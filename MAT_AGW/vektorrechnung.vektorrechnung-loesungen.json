fe6f763cd9b15d0f49a0c3b0.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"RMezWxqkZB"}],"key":"itJkZ6u4wq"}],"identifier":"c23b906a-6d28-4c2c-9d85-a099f391c0c2","html_id":"c23b906a-6d28-4c2c-9d85-a099f391c0c2","key":"Rh0MwTAAKr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Übung 2","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"N8lSa47gCb"}],"identifier":"id-bung-2","label":"Übung 2","html_id":"id-bung-2","implicit":true,"key":"FORfdHvFcB"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"a)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EnYDz0MuWM"}],"key":"NbGGilLFsN"}],"identifier":"0a517fd0-3ae7-4d38-9aac-71750d8f07d6","html_id":"0a517fd0-3ae7-4d38-9aac-71750d8f07d6","key":"g3GYHZJRll"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"v = np.array([1.32, 0.48])  # Geschwindigkeitsvektor [m/s]\nF = np.array([81.9, 57.4])  # Kraft [N]\n\nP = np.dot(F, v)  # Leistung via Skalarprodukt [W]\nprint(P)","key":"pGXdihoNZe"},{"type":"outputs","id":"6xzj21lIAhaUlbydKHs_U","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"135.66000000000003\n"},"children":[],"key":"ucJjCUE8vY"}],"key":"arLsFlmq8G"}],"identifier":"78c48292-1a3b-4410-9b6e-a0b4adec4918","html_id":"78c48292-1a3b-4410-9b6e-a0b4adec4918","key":"tIuhuinX2N"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"b)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ntsoxSbEIO"}],"key":"GOb9FXldAv"}],"identifier":"5fa121bb-55b0-4ea4-ad36-1a7c94ce6721","html_id":"5fa121bb-55b0-4ea4-ad36-1a7c94ce6721","key":"VKBmwgWB6p"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Der Winkel zwischen zwei Vektoren kann via Skalarprodukt berechnet werden \n# Die Definition des Skalarproduktes nach dem Winkel umstellen \nalpha = np.arccos(np.dot(F, v)/(np.linalg.norm(v)*np.linalg.norm(F)))  # Winkel [rad]\nprint(np.rad2deg(alpha))  # Winkel [°]","key":"Sr4m3B61Mx"},{"type":"outputs","id":"tY6EQR3XM8jlV2xGF2KVF","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"15.041766757641366\n"},"children":[],"key":"F2Fd9MV8i1"}],"key":"to7VcujDe7"}],"identifier":"9d0a8f58-ecdf-4459-9baa-ef212a29a2c4","html_id":"9d0a8f58-ecdf-4459-9baa-ef212a29a2c4","key":"oOFMKgAyMN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Übung 3","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xD4JQaPKRL"}],"identifier":"id-bung-3","label":"Übung 3","html_id":"id-bung-3","implicit":true,"key":"FLm5nqFnNo"}],"identifier":"e00d6db5-082a-4ec1-9e96-169356be63ea","html_id":"e00d6db5-082a-4ec1-9e96-169356be63ea","key":"wvvNXsuqiO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"p = np.array([1, 2, 3])\nphi = np.deg2rad(45)  # Drehwinkel [rad]\n\nR = np.array([[np.cos(phi), -np.sin(phi), 0],  # Drehmatrix um z-Achse (vgl. Theorienotebook)\n              [np.sin(phi), np.cos(phi),  0],\n              [0,           0,            1]])\n\np_strich = R @ p  # gedrehter Vektor\nprint(p_strich)","key":"kHnm20eA7O"},{"type":"outputs","id":"cbH-q_h2OKuwLUXOc5XrJ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[-0.70710678  2.12132034  3.        ]\n"},"children":[],"key":"xz2bo1r8KC"}],"key":"OmKg2ipLvP"}],"identifier":"b62c66d6-be78-4d9f-9ab9-2aa4e7095aa1","html_id":"b62c66d6-be78-4d9f-9ab9-2aa4e7095aa1","key":"h9WZ3WaHuN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Übung 4","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zfvucf1vK5"}],"identifier":"id-bung-4","label":"Übung 4","html_id":"id-bung-4","implicit":true,"key":"kpCEXi87gc"}],"identifier":"b80d4534-3541-4ca9-a1b4-50ca2888c1c6","html_id":"b80d4534-3541-4ca9-a1b4-50ca2888c1c6","key":"tjKio0tqef"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"p = np.array([5.5, 2.5])  # Vektor im xy-Koordinatensystem\nt = np.array([10, 2])  # Versatz der Koordinatensysteme\nphi = np.deg2rad(90)  # Verdrehung der Koordinatensysteme [rad]\nR = np.array([[np.cos(phi), -np.sin(phi)],  # Drehmatrix\n              [np.sin(phi), np.cos(phi)]])\n\np_strich = R.T @ (p - t)  # Vektor im x'y'-Koordinatensystem (Multipl. mit der transp. Drehmatrix)\nprint(p_strich)","key":"I28085EPBH"},{"type":"outputs","id":"fVfbnnE7dXZB8Mad-UYtc","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[0.5 4.5]\n"},"children":[],"key":"caC8KgVnxq"}],"key":"Hn4Lx1nT1R"}],"identifier":"45609543-d163-4bcc-9ea1-958ee93109d7","html_id":"45609543-d163-4bcc-9ea1-958ee93109d7","key":"mRQRyF49cw"}],"key":"q9vl6VQxOh"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Übungen","url":"/vektorrechnung/vektorrechnung-uebungen","group":"Angewandte Mathematik"},"next":{"title":"Statistik / Messunsicherheit","url":"/datenauswertung/datenauswertung","group":"Angewandte Mathematik"}}},"domain":"http://localhost:3000"}