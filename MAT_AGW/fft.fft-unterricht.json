ibility":"show","key":"irCNJy8dxe"}],"identifier":"cad9b1a4-89a6-4fd7-89e0-4f00b2bfc090","html_id":"cad9b1a4-89a6-4fd7-89e0-4f00b2bfc090","visibility":"show","key":"QwfhTn0QBG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"y = (3.5 +\n     2.5 * np.sin(2*np.pi*25*t) +\n     1.5 * np.sin(2*np.pi*37*t) +\n     1.25 * np.random.randn(N))\n\nY = fft.rfft(y)/N\nA = np.abs(Y)\nA[1:] *= 2\nf = fft.rfftfreq(N, 1/fs)\n\nfig, axs = plt.subplots(nrows=2, figsize=(10,6))\naxs[0].plot(t, y, 'b')\naxs[0].grid()\naxs[0].set_xlabel('Zeit [s]')\naxs[0].set_ylabel('Signal [..]')\naxs[1].plot(f, A, 'r')\naxs[1].grid()\naxs[1].set_xlabel('Frequenz [Hz]')\naxs[1].set_ylabel('Amplitude [..]')\nplt.show()","key":"bn3iGx74D4"},{"type":"outputs","id":"FBZhnY0-Lg3ANwBMjatV4","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"ec533b75617be61217b554184caa93f2","path":"/MAT_AGW/build/ec533b75617be61217b554184caa93f2.png"},"text/plain":{"content":"<Figure size 1000x600 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"ac7iWf7x3Y"}],"key":"F8tQqim7Un"}],"identifier":"6a626597-d7aa-485c-ac1d-84a6c7c00be1","html_id":"6a626597-d7aa-485c-ac1d-84a6c7c00be1","key":"zRLYVlZGZo"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Erkennst du im Amplitudenspektrum die verschiedenen Anteile (Gleichanteil, Sinusschwingungen)? Woran erkennt man, dass das Signal verrauscht ist?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zX9gTtS1Rp"}],"key":"JG0XFaIazb"}],"identifier":"cf09161c-c919-47da-b260-69cb3e4a7000","html_id":"cf09161c-c919-47da-b260-69cb3e4a7000","key":"DpdOMbCDA9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"valu